# Active profiles — controls which services start
# Profiles: bot, one-pace, fantasy, wallapop, torre, display, all
# all → every profile but one-pace
COMPOSE_PROFILES=all

# Base data path — must match rpi-homeserver
DATA_ROOT=/mnt/data
APP_CONFIG_PATH=./appdata

# Telegram Bot Tokens
BOT_POL_ACADEMY_OFFERS_TOKEN="your_telegram_bot_token_here"

# Wallabot — the public bot where the new listings of each chat's searches are sent.
# A bot from @BotFather, and the owner's chat id.
WALLA_TELEGRAM_TOKEN=your_telegram_bot_token
WALLA_TELEGRAM_CHAT=your_telegram_chat_id

# The services bot (@PlatanosServicesBot), shared by the small services. Anyone may send
# with it, but only one service may read its updates: today wallapop-catalogue.
TELEGRAM_BOT_SERVICES=your_telegram_bot_token

# torre's own bot (@TorreFlightsBot), from BotFather
TELEGRAM_BOT_TORRE=your_telegram_bot_token

# pixelhub: the ESP32 bridge (an IP, mDNS does not resolve in containers) and the display's Bluetooth address
PIXELHUB_BRIDGE=192.0.2.10:7777
PIXELHUB_DEVICE_MAC=01:12:23:45:56:67
