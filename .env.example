# Active profiles — controls which services start
# Profiles: cal, bot, one-pace, all
# all → cal + bot
COMPOSE_PROFILES=all

# Base data path — must match rpi-homeserver
DATA_ROOT=/mnt/data
APP_CONFIG_PATH=./appdata

# Telegram Bot Tokens
BOT_POL_ACADEMY_OFFERS_TOKEN="your_telegram_bot_token_here"

# Google Calendar Bridge (cal-bridge)
# OAuth2 credentials from Google Cloud Console (https://console.cloud.google.com)
# Create an OAuth2 "Web application" credential
# Add https://cal.yourdomain.com/callback as redirect URI
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Random secret used by the ESP32 to authenticate requests (generate with: openssl rand -hex 16)
CAL_API_KEY=your_random_secret
# Public base URL for OAuth2 redirect
# CAL_BASE_URL=https://cal.yourdomain.com

# Microsoft / Outlook (optional — only needed for Outlook/M365 calendar)
# Register an app at https://portal.azure.com → App registrations
# Add redirect URI: https://cal.yourdomain.com/callback/microsoft
# Grant delegated permission: Microsoft Graph → Calendars.Read
# MS_CLIENT_ID=your_azure_app_client_id
# MS_CLIENT_SECRET=your_azure_app_client_secret
# MS_SECRET_CREATES=YYYY-MM-DD
# MS_SECRET_DAYS_DURATION=365
