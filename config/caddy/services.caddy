# laliga-fantasy's tailnet door. The page can place real bids: from outside it is only
# reachable through Cloudflare Access, which goes to the app directly, not through here.
https://fantasy.platanosverdes.com {
    log
    import cf_tls

    reverse_proxy laliga-fantasy:8000
}

# laliga-fantasy's stage: read-only, a branch under test, off most of the time (502 then).
https://fantasy-stage.platanosverdes.com {
    log
    import cf_tls

    reverse_proxy laliga-fantasy-stage:8000
}
