https://cal.platanosverdes.com {
    import cf_tls
    reverse_proxy cal-bridge:8000
}

# air-tag — location map. Locked down because it exposes where you move:
#   - Only reachable inside the tailnet: the *.platanosverdes.com names resolve to
#     the Tailscale IP and nothing is port-forwarded to the internet.
#   - HTTP basic auth on top (hash generated with: caddy hash-password).
# NOTE: a remote_ip allowlist does NOT work here — Caddy runs on a Docker bridge
# network, so external traffic is source-NAT'd to the docker gateway (172.x) and
# Caddy never sees the real client IP. basic_auth + tailnet-only is the real gate.
https://airtag.platanosverdes.com {
    import cf_tls

    basic_auth {
        jorge $2b$14$3nM4hQ7pc41HLLvbUNVmsetIGIN0B1rMK2BDnClUWi03Np1yAxTEC
    }
    reverse_proxy air-tag:8000
}

# laliga-fantasy — panel de decisiones del fantasy. Solo alcanzable dentro del
# tailnet, que es la unica puerta: la pagina puede lanzar pujas con dinero real, asi
# que lo que la protege es que nadie mas llega hasta aqui.
https://fantasy.platanosverdes.com {
    log
    import cf_tls

    reverse_proxy laliga-fantasy:8000
}
