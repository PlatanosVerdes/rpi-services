# streamhalla, the second machine, by name instead of IP:port. Caddy reaches it over Tailscale, so
# these only work from the tailnet; its LAN keeps using the machine directly (the TV's Jellyfin app).
https://prometheus.streamhalla.platanosverdes.com {
    import cf_tls
    reverse_proxy 100.120.107.32:9090
}

https://jellyfin.streamhalla.platanosverdes.com {
    import cf_tls
    reverse_proxy 100.120.107.32:8096
}

https://bifrost.streamhalla.platanosverdes.com {
    import cf_tls
    reverse_proxy 100.120.107.32:6879
}
