{
  "uid": "laliga-fantasy",
  "title": "LaLiga Fantasy",
  "tags": [
    "fantasy",
    "laliga-fantasy"
  ],
  "schemaVersion": 42,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "preload": false,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timezone": "browser",
  "timepicker": {},
  "links": [],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "Estado",
      "collapsed": false,
      "panels": [],
      "id": 1,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "Panel",
      "description": "El /healthz del contenedor y la entrada pública por Cloudflare Access: arriba solo si responden los dos.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "caído",
                  "color": "red"
                },
                "1": {
                  "text": "arriba",
                  "color": "green"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "min(probe_success{service=\"laliga-fantasy\"})",
          "instant": true,
          "legendFormat": "__auto"
        }
      ],
      "id": 2,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Versión",
      "description": "La imagen que corre ahora.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "name",
        "wideLayout": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "label_replace(topk(1, container_last_seen{name=\"laliga-fantasy\"}), \"version\", \"$1\", \"image\", \".*:(.*)\")",
          "instant": true,
          "legendFormat": "{{version}}"
        }
      ],
      "id": 3,
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 4,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "LaLiga nos frena",
      "description": "1 mientras la cola está en pausa tras un 429.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "no",
                  "color": "green"
                },
                "1": {
                  "text": "en pausa",
                  "color": "red"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "max(upstream_paused{upstream=\"fantasy-api.llt-services.com\"})",
          "instant": true,
          "legendFormat": "__auto"
        }
      ],
      "id": 4,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 10,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Peticiones 24h",
      "description": "Peticiones enviadas a la API de LaLiga en las últimas 24 horas (las que sirve la caché no cuentan).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(increase(upstream_requests_total{upstream=\"fantasy-api.llt-services.com\"}[24h]))",
          "instant": true,
          "legendFormat": "__auto"
        }
      ],
      "id": 5,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 14,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "429 en 24h",
      "description": "Respuestas 429 de LaLiga en las últimas 24 horas.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(increase(upstream_rate_limited_total[24h]))",
          "instant": true,
          "legendFormat": "__auto"
        }
      ],
      "id": 6,
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 18,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Memoria",
      "description": "Memoria en uso del contenedor.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "mappings": [],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "max(container_memory_working_set_bytes{name=\"laliga-fantasy\"})",
          "instant": true,
          "legendFormat": "__auto"
        }
      ],
      "id": 7,
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 21,
        "y": 1
      }
    },
    {
      "type": "row",
      "title": "LaLiga y reconstrucciones",
      "collapsed": false,
      "panels": [],
      "id": 8,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      }
    },
    {
      "type": "timeseries",
      "title": "Peticiones a LaLiga",
      "description": "Por minuto. Rechazadas: las que la cola no mandó por estar en pausa o por esperar demasiado.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(rate(upstream_requests_total{upstream=\"fantasy-api.llt-services.com\"}[5m])) * 60",
          "legendFormat": "enviadas",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "sum(rate(upstream_rate_limited_total[5m])) * 60",
          "legendFormat": "429",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C",
          "expr": "sum(rate(upstream_refused_total[5m])) * 60",
          "legendFormat": "rechazadas",
          "range": true
        }
      ],
      "id": 9,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      }
    },
    {
      "type": "timeseries",
      "title": "Reconstrucciones del mundo",
      "description": "Cuánto tarda cada reconstrucción (máximo y media por intervalo).",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "refId": "A",
          "expr": "container:laliga-fantasy _msg:\"world rebuilt\" | stats max(ms) max, avg(ms) media",
          "queryType": "statsRange"
        }
      ],
      "id": 10,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      }
    },
    {
      "type": "row",
      "title": "Equipo",
      "collapsed": false,
      "panels": [],
      "id": 11,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
      }
    },
    {
      "type": "timeseries",
      "title": "xPts del plan",
      "description": "Los puntos esperados del once antes y después de los movimientos que propone el plan.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "refId": "A",
          "expr": "container:laliga-fantasy _msg:\"plan ready\" | stats max(xpts_before) \"sin cambios\", max(xpts_after) \"con el plan\"",
          "queryType": "statsRange"
        }
      ],
      "id": 12,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 15
      }
    },
    {
      "type": "timeseries",
      "title": "Caja",
      "description": "Saldo real, lo que tienes en pujas y ofertas pendientes y lo que queda libre.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyEUR",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "refId": "A",
          "queryType": "statsRange",
          "expr": "container:laliga-fantasy _msg:\"plan ready\" | math cash_before + committed as saldo | stats max(saldo) saldo, max(committed) \"en pujas\", max(cash_before) libre"
        }
      ],
      "id": 13,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 15
      }
    },
    {
      "type": "row",
      "title": "Escrituras y errores",
      "collapsed": false,
      "panels": [],
      "id": 14,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 23
      }
    },
    {
      "type": "logs",
      "title": "Escrituras",
      "description": "Pujas, ofertas, cláusulas, alineaciones y favoritos: las hechas, las automáticas y las rechazadas con el motivo.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "refId": "A",
          "expr": "container:laliga-fantasy _msg:in(\"write done\",\"write refused\",\"automatic write done\") | format \"<_msg> · <operation> <player> <amount> <reason>\" as _msg",
          "queryType": "range",
          "maxLines": 200
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "id": 15,
      "gridPos": {
        "h": 10,
        "w": 14,
        "x": 0,
        "y": 24
      }
    },
    {
      "type": "logs",
      "title": "Errores y avisos",
      "description": "Todo lo que no es INFO, menos los 503 de /healthz mientras arranca.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "refId": "A",
          "expr": "container:laliga-fantasy level:in(ERROR,WARN) -path:\"/healthz\"",
          "queryType": "range",
          "maxLines": 200
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "id": 16,
      "gridPos": {
        "h": 10,
        "w": 10,
        "x": 14,
        "y": 24
      }
    },
    {
      "type": "timeseries",
      "title": "Uso del panel",
      "description": "Peticiones al panel por entrada: access es la pública con Cloudflare Access, private la de la tailnet.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 2,
            "fillOpacity": 80,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "refId": "A",
          "expr": "container:laliga-fantasy _msg:http door:* | stats by (door) count() peticiones",
          "queryType": "statsRange"
        }
      ],
      "id": 17,
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 34
      }
    }
  ]
}