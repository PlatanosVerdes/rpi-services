# Versions — single source of truth (same convention as rpi-homeserver's versions.env).
#
# App images on GHCR, bumped by .github/workflows/bump-app-versions.yml.
#
# Loaded via COMPOSE_ENV_FILES=versions.env,.env (set by apply.sh). To run compose
# by hand: export COMPOSE_ENV_FILES=versions.env,.env
#
# These are versions/digests, NOT secrets, so this file IS committed to git.

# --- apps ---
ONE_PACE_VERSION=v2026.10.23
POL_BOT_VERSION=v2026.10.23
LALIGA_FANTASY_VERSION=v2026.10.23.1
# Set by the app's Stage workflow.
LALIGA_FANTASY_STAGE_VERSION=stage-2c02a51bf53c
LALIGA_FANTASY_STAGE_ON=0
WALLABOT_VERSION=v2026.10.23
WALLAPOP_CATALOGUE_VERSION=v2026.10.17
TORRE_VERSION=v2026.10.19.2

