# Versions — single source of truth (same convention as rpi-homeserver's versions.env).
#
# App images are built from their own repos, pinned to the CalVer tag (vYYYY.MM.DD) that each
# repo's auto-tag workflow creates on every push to main. Bumped automatically by
# .github/workflows/bump-app-versions.yml; that commit is what triggers the deploy.
#
# Loaded via COMPOSE_ENV_FILES=versions.env,.env (set by apply.sh). To run compose
# by hand: export COMPOSE_ENV_FILES=versions.env,.env
#
# These are versions/digests, NOT secrets, so this file IS committed to git.

# --- apps (built from their own repos) ---
CAL_BRIDGE_VERSION=v2026.07.01
ONE_PACE_VERSION=v2026.07.27
AIR_TAG_VERSION=v2026.07.24
POL_BOT_VERSION=v2026.07.22
LALIGA_FANTASY_VERSION=v2026.08.19.15

# --- third-party images ---
# anisette-v3-server publishes no version tags (only :latest), so it is pinned by digest.
# To update: docker pull dadoum/anisette-v3-server:latest && \
#            docker image inspect --format '{{index .RepoDigests 0}}' dadoum/anisette-v3-server:latest
ANISETTE_DIGEST=sha256:1e20384985d3c49965f444bef39d627768dacc39ea0dca91f2a535edb7591ba3
